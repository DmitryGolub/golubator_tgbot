BOT_TOKEN=replace-me

LOG_LEVEL=DEBUG
LOG_FORMAT=dev

DB_NAME=botdb
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

ADMIN_IDS=

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Notion multi-database sync
NOTION_MENTOR_DB_ID=
NOTION_MENTEE_DB_ID=
NOTION_EVENT_DB_ID=
NOTION_MENTEE_TEMPLATE_PAGE_ID=

# Notion internal API (for backfill script only)
NOTION_TOKEN_V2=
NOTION_SPACE_ID=

# Webhook authentication (append ?secret=<value> to Notion Automation URLs)
# Allowed characters: A-Z, a-z, 0-9, hyphen, underscore
NOTION_WEBHOOK_SECRET=

# Sync intervals (seconds)
NOTION_PUSH_INTERVAL=30
NOTION_BACKUP_POLL_USERS_INTERVAL=1800
NOTION_BACKUP_POLL_EVENTS_INTERVAL=600

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# ngrok (dev only, make up)
NGROK_AUTHTOKEN=
