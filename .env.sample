BOT_TOKEN=replace-me

LOG_LEVEL=DEBUG
LOG_FORMAT=dev

DB_NAME=botdb
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

ADMIN_IDS=

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Notion multi-database sync
NOTION_MENTOR_DB_ID=
NOTION_MENTEE_DB_ID=
NOTION_EVENT_DB_ID=

# Sync intervals (seconds)
NOTION_PUSH_INTERVAL=30
NOTION_BACKUP_POLL_USERS_INTERVAL=1800
NOTION_BACKUP_POLL_EVENTS_INTERVAL=600

# Yandex Sheets export
YANDEX_SHEETS_TOKEN=
YANDEX_SHEETS_FILE_PATH=disk:/analytics/feedback_export.xlsx
YANDEX_SHEETS_SHEET_NAME=feedback_export
YANDEX_SHEETS_BASE_URL=https://cloud-api.yandex.net/v1/disk
YANDEX_SHEETS_TIMEOUT_SECONDS=30

# ngrok (dev only, make up)
NGROK_AUTHTOKEN=

# Production (make up-prod)
DOMAIN=bot.example.com
CERTBOT_EMAIL=admin@example.com
