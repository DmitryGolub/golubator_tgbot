BOT_TOKEN=replace-me

LOG_LEVEL=DEBUG
LOG_FORMAT=dev  # use "json" in production for structured logging (Loki/Promtail)

DB_NAME=botdb
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

ADMIN_IDS=

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Notion multi-database sync
NOTION_MENTOR_DB_ID=
NOTION_MENTEE_DB_ID=
NOTION_EVENT_DB_ID=
NOTION_MENTEE_TEMPLATE_PAGE_ID=

# Notion internal API (for backfill script only)
NOTION_TOKEN_V2=
NOTION_SPACE_ID=

# Webhook authentication (set as X-Notion-Secret header in Notion Automations)
NOTION_WEBHOOK_SECRET=

# Sync intervals (seconds)
NOTION_PUSH_INTERVAL=30
NOTION_BACKUP_POLL_USERS_INTERVAL=1800
NOTION_BACKUP_POLL_EVENTS_INTERVAL=600

# Telegram channel for general chat (invite links)
GENERAL_CHAT_ID=

# Domains
NOTION_DOMAIN=notion.pigeon.careers
GRAFANA_DOMAIN=grafana.pigeon.careers

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=https://grafana.pigeon.careers/

# Loki multi-tenant auth (X-Scope-OrgID header)
LOKI_TENANT_ID=golubator

# ngrok (dev only, make up)
NGROK_AUTHTOKEN=

# CalDAV sync (one-way Meeting → mentor's iCloud / Yandex calendar)
# Feature toggle. When enabled, CALDAV_ENCRYPTION_KEY is required.
CALDAV_ENABLED=false
# Fernet key. Generate via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALDAV_ENCRYPTION_KEY=
# Comma-separated older Fernet keys for decryption during rotation.
CALDAV_ENCRYPTION_KEYS_FALLBACK=
CALDAV_SYNC_INTERVAL_SECONDS=60
CALDAV_HOSTNAME=golubator.pigeon.careers
CALDAV_HTTP_TIMEOUT_SECONDS=15
