{
  "uid": "service-health",
  "title": "Service Health",
  "description": "Operational monitoring: logs, error rates, service status",
  "tags": ["ops", "loki"],
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "current": {
          "text": ["bot", "celery_worker", "celery_beat"],
          "value": ["bot", "celery_worker", "celery_beat"]
        },
        "options": [
          { "text": "All", "value": "$__all", "selected": false },
          { "text": "bot", "value": "bot", "selected": true },
          { "text": "celery_worker", "value": "celery_worker", "selected": true },
          { "text": "celery_beat", "value": "celery_beat", "selected": true }
        ],
        "query": "bot,celery_worker,celery_beat",
        "includeAll": true,
        "multi": true,
        "allValue": "bot|celery_worker|celery_beat"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "$service",
      "description": "Green = container running AND /health OK, Orange = container running but /health failing, Red = container missing",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
      "repeat": "service",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
          "expr": "max(probe_success{service=\"$service\"})",
          "instant": true,
          "legendFormat": "health"
        },
        {
          "refId": "B",
          "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
          "expr": "max(probe_http_status_code{service=\"$service\"}) > bool 0",
          "instant": true,
          "legendFormat": "running"
        },
        {
          "refId": "C",
          "datasource": { "uid": "__expr__", "type": "__expr__", "name": "Expression" },
          "type": "math",
          "expression": "$A + $B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "2": { "text": "UP",        "color": "green"  } } },
            { "type": "value", "options": { "1": { "text": "UNHEALTHY", "color": "orange" } } },
            { "type": "value", "options": { "0": { "text": "MISSING",   "color": "red"    } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "MISSING", "color": "red" } } }
          ],
          "color": { "mode": "fixed" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^C$/" },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "Error Rate",
      "description": "Errors per second by service",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service)(rate({service=~\"$service\", level=\"ERROR\"} [5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "drawStyle": "line",
            "pointSize": 5
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Log Volume",
      "description": "Total log lines per minute by service",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service)(count_over_time({service=~\"$service\"} [1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "drawStyle": "bars",
            "stacking": { "mode": "normal" }
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Errors Over Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 5 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service)(count_over_time({service=~\"$service\", level=\"ERROR\"} [$__interval]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "drawStyle": "line",
            "pointSize": 5
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Warnings Over Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 5 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service)(count_over_time({service=~\"$service\", level=\"WARNING\"} [$__interval]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "drawStyle": "line",
            "pointSize": 5
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Log Level Distribution",
      "description": "Distribution of log entries by level",
      "type": "piechart",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 5 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (level)(count_over_time({service=~\"$service\", level=~\".+\"} [$__range]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              { "fieldName": "level", "handlerKey": "field.name" }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["percent", "value"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 6,
      "title": "Recent Errors",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "maxDataPoints": 200,
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\", level=\"ERROR\"}",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 8,
      "title": "Recent Warnings",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "maxDataPoints": 200,
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\", level=\"WARNING\"}",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 7,
      "title": "Service Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "maxDataPoints": 1000,
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"}",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "schemaVersion": 39
}
