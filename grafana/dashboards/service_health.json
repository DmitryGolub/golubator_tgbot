{
  "uid": "service-health",
  "title": "Service Health",
  "description": "Operational monitoring: logs, error rates, service status",
  "tags": ["ops", "loki"],
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "current": {
          "text": ["bot", "celery_worker", "celery_beat"],
          "value": ["bot", "celery_worker", "celery_beat"]
        },
        "options": [
          { "text": "All", "value": "$__all", "selected": false },
          { "text": "bot", "value": "bot", "selected": true },
          { "text": "celery_worker", "value": "celery_worker", "selected": true },
          { "text": "celery_beat", "value": "celery_beat", "selected": true }
        ],
        "query": "bot,celery_worker,celery_beat",
        "includeAll": true,
        "multi": true,
        "allValue": "bot|celery_worker|celery_beat"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Service Status",
      "description": "Sparkline shows probe health over time (0=MISSING, 1=UNHEALTHY, 2=UP). Green = container running AND /health OK, orange = container running but /health failing, red = container missing",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
          "expr": "sum by (service)(probe_success{service=~\"$service\"}) + sum by (service)(probe_http_status_code{service=~\"$service\"} > bool 0)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "2": { "text": "UP",        "color": "green"  } } },
            { "type": "value", "options": { "1": { "text": "UNHEALTHY", "color": "orange" } } },
            { "type": "value", "options": { "0": { "text": "MISSING",   "color": "red"    } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "MISSING", "color": "red" } } }
          ],
          "color": { "mode": "fixed" },
          "min": 0,
          "max": 2
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "name",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "Error Rate",
      "description": "Errors per second by service",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service)(rate({service=~\"$service\"} | json | level=\"ERROR\" [5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "drawStyle": "line",
            "pointSize": 5
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Log Volume",
      "description": "Total log lines per minute by service",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service)(count_over_time({service=~\"$service\"} [1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "drawStyle": "bars",
            "stacking": { "mode": "normal" }
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Errors Over Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 5 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service)(count_over_time({service=~\"$service\"} | json | level=\"ERROR\" [$__interval]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "drawStyle": "line",
            "pointSize": 5
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Warnings Over Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 5 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service)(count_over_time({service=~\"$service\"} | json | level=\"WARNING\" [$__interval]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "drawStyle": "line",
            "pointSize": 5
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Log Level Distribution",
      "description": "Distribution of log entries by level",
      "type": "piechart",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 5 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (level)(count_over_time({service=~\"$service\"} | json | level=~\".+\" [$__range]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              { "fieldName": "level", "handlerKey": "field.name" }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["percent", "value"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 10,
      "title": "Container CPU %",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 12 },
      "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"tg_bot.*\"}[5m]) * 100",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2, "drawStyle": "line" }
        }
      }
    },
    {
      "id": 11,
      "title": "Container Memory MB",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 12 },
      "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
          "expr": "container_memory_working_set_bytes{name=~\"tg_bot.*\"} / 1048576",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2, "drawStyle": "line" }
        }
      }
    },
    {
      "id": 12,
      "title": "Celery Tasks / sec",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 12 },
      "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
          "expr": "sum by (task_name, status)(rate(celery_task_total[5m]))",
          "legendFormat": "{{task_name}} / {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2, "drawStyle": "line" }
        }
      }
    },
    {
      "id": 13,
      "title": "Celery Duration p95",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 12 },
      "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "prometheus-metrics", "type": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (task_name, le)(rate(celery_task_duration_seconds_bucket[5m])))",
          "legendFormat": "{{task_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2, "drawStyle": "line" }
        }
      }
    },
    {
      "id": 6,
      "title": "Recent Errors",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"} |~ `\"level\": \"ERROR\"` | drop service_name",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 8,
      "title": "Recent Warnings",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"} |~ `\"level\": \"WARNING\"` | drop service_name",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 7,
      "title": "Service Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 35 },
      "datasource": { "uid": "loki-logs", "type": "loki" },
      "maxDataPoints": 1000,
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"} | drop service_name",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "schemaVersion": 39
}
