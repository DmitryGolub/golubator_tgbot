server {
    listen 80;
    server_name grafana.pigeon.careers;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name grafana.pigeon.careers;

    ssl_certificate /etc/letsencrypt/live/notion.pigeon.careers/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/notion.pigeon.careers/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/notion.pigeon.careers/chain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/grafana.pigeon.careers.access.log;
    error_log /var/log/nginx/grafana.pigeon.careers.error.log;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
